# 可在 OOBE 中保存到数据库；此环境变量仅作为兼容回退。不要提交真实密钥。
YZWC_GAME_API_KEY=replace-with-at-least-32-random-characters

# Cloudflare Turnstile 登录保护。站点密钥可以公开，服务端密钥不得提交到仓库。
NUXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET=replace-with-your-turnstile-secret
# 生产环境只填写实际前端域名，不要包含 localhost 或 127.0.0.1。
# 官网首页聊天区的 widget 跑在主站域名下，必须把主站域名一起列入（逗号分隔），
# 否则聊天发言会被判为人机验证失败。示例：api.mcyzw.top,mcyzw.top
TURNSTILE_HOSTNAMES=replace-with-allowed-hostname

# 聊天区 IP 归属地解析。默认调用第三方中文 IP 库取省市级归属地并按 IP 哈希缓存 7 天；
# 置为 1 可关闭外呼，仅回退到 Cloudflare 的 cf-ipcountry 国家级信息。
# YZWC_IP_GEO_DISABLED=1

# 后台密码和登录入口默认在首次访问根目录时设置。
# 如需无人值守初始化，可同时提供下面两个变量。
# YZWC_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# YZWC_ADMIN_USERNAME=admin
# YZWC_ADMIN_ENTRY=replace-with-12-to-64-random-characters

# 游戏会话最长 24 小时，默认 12 小时。
YZWC_GAME_SESSION_TTL_SECONDS=43200
